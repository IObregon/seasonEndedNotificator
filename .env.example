APP_DOMAIN=season-ended.localhost
POSTGRES_DB=seasonended
POSTGRES_USER=seasonended
POSTGRES_PASSWORD=change-me

# Admin account created on first run. Leave blank to skip.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost

# Optional: Telegram bot for digest delivery (leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: Web Push via VAPID keys (leave blank to disable)
# Generate with: npx web-push generate-vapid-keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:admin@example.com

# ── VPS deployment (GitHub Actions) ──
# These are NOT used locally. Set as GitHub repository secrets.
#
# VPS_HOST          — server hostname or IP
# VPS_USER          — SSH user (must have docker access)
# VPS_SSH_KEY       — private SSH key
# VPS_PORT          — SSH port (default 22)
# VPS_DEPLOY_PATH   — directory on VPS containing repo checkout
# GHCR_PAT          — GitHub PAT with read:packages for docker login
# IMAGE_TAG         — set automatically to commit SHA by CI
